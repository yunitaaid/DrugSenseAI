      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "const aiResponse = items[0].json.candidates?.[0]?.content?.parts?.[0]?.text || \"Tidak ada hasil dari Gemini\";\n\nreturn [{\n  json: {\n    ...$json,\n    analisis_ai: aiResponse\n  }\n}];\n"
      },
      "id": "8e0bc6b0-0109-4f33-b32e-6a95b4959fc3",
