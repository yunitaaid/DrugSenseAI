    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=AIzaSyA5cdCBX78J3hBl1-aGu2DTAzWbTNWAXOE",
        "jsonParameters": true,
        "options": {
          "bodyContentType": "json"
        },
        "bodyParametersJson": "={{ JSON.stringify({\n  contents: [\n    {\n      role: \"user\",\n      parts: [\n        {\n          text: \"Kamu adalah asisten medis yang menganalisis data obat.\\n\" +\n                \"Sebutkan definisi, efek samping dan interaksi antar obat lain berdasarkan data berikut:\\n\" +\n                JSON.stringify($json)\n        }\n      ]\n    }\n  ]\n}) }}\n",
        "headerParametersJson": "={\n  \"Content-Type\": \"application/json\"\n}"
      },
      "id": "9f95caa3-725d-447f-9e96-5f74f227ebef",
      "name": "Gemini API",
      "type": "n8n-nodes-base.httpRequest",
